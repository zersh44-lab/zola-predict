{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py?__route__=/api/status"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__route__=/api/$1"
    }
  ]
}
