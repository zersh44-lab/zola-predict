# ZOLA PREDICT - Environment Configuration Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control or expose credentials.

# Required API credentials
FOOTBALL_API_KEY=
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional AI Research Providers (Gemini, Groq, OpenRouter, local Ollama)
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=
AI_PROVIDER=

# Live football data provider. API-Football is the primary live source.
# Supported: api-football (API-Sports v3) or football-data (football-data.org v4).
FOOTBALL_API_PROVIDER=api-football
FOOTBALL_API_BASE_URL=

# Local Storage and Cache Configuration
ZOLA_DB_PATH=
ZOLA_CACHE_TTL_MINUTES=
ZOLA_RATE_LIMIT_RPM=
